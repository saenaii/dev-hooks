# How to consume these hooks. Copy this file to the root of your repository
# as .pre-commit-config.yaml, then run `pre-commit install`.
#
# Requirements on your PATH: the Go toolchain (gofmt) and golangci-lint v2.

repos:
  # Published usage: reference this repository by URL and pin rev to a tag.
  # Tag a release from dev-hooks with: git tag v0.1.0 && git push --follow-tags
  - repo: https://github.com/saenaii/dev-hooks
    rev: v0.1.0
    hooks:
      - id: golang-lint

  # Local usage, e.g. while developing the hooks: reference a local checkout
  # and pin rev to a local commit.
  # - repo: /Users/saenai/github/dev-hooks
  #   rev: 0d6c1be
  #   hooks:
  #     - id: golang-lint
